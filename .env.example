# Copy to .env and fill in. Never commit .env.

# Hardware: "sim" (no board needed) or "real" (Raspberry Pi with INA219s and relays)
DYNAURA_HW=sim

# REAL mode only (pi/hw/real.py). Check the sensors with `i2cdetect -y 1`; "none" = no sensor on that flat.
INA_PANEL=0x45
INA_A=0x41
INA_B=0x44
INA_C=0x40
# Relay board: active-low (pinctrl "dl" = clicked on). Flat A/B/C and the pump.
RELAY_ACTIVE_LOW=true
RELAY_A_GPIO=17
RELAY_B_GPIO=27
RELAY_C_GPIO=22
PUMP_GPIO=23
# Volts for low-side flat sensors (the power bank), and the panel's volts if its sensor can't read them
SUPPLY_V=5.0
PANEL_V=6.0
# A flat with no sensor reports this much current (one lit LED through 220 ohm)
FLAT_NOMINAL_MA=10.5

# SIM mode only: how fast the simulated day runs (1 = real time, 60 = 1 minute per second)
SIM_SPEED=1
# SIM mode only: start the simulated day at this time (HH:MM). Empty = real clock.
SIM_START=11:00

# Sun forecast (Open-Meteo, no key needed)
LAT=19.07
LON=72.88
TIMEZONE=Asia/Kolkata
# Real rooftop size the model building stands for (kW peak)
BUILDING_KWP=2.0

# Society job runner
PLAN_HOUR=20
SOLAR_MIN_W=0.3
PUMP_SECONDS=8
# Demo under a desk lamp at night: true = ignore the plan's hours, follow the panel only
IGNORE_CLOCK=false
# Scenario 2: flats away + spare sun -> 0G decides whether the tank pump runs now (web: /scenarios)
SPARE_PUMP=true
# spare power needed (W, model scale); empty = SOLAR_MIN_W. At most one automatic 0G ask per cooldown.
SPARE_PUMP_MIN_W=
SPARE_PUMP_COOLDOWN_S=180
# Real board: the panel meter reads the sun through its own load. false = it only reads what flats draw.
PANEL_READS_AVAILABLE=true
# Shared secret for admin changes from the web app (also set VITE_ADMIN_KEY in web/.env)
ADMIN_KEY=change-me

# Spare solar sold to nearby shops (USDC per kWh)
SHOP_PRICE_USDC=0.08
# A metered live offer stays buyable for this many wall-clock minutes.
MARKET_OFFER_TTL_MIN=10

# Pi API
API_HOST=0.0.0.0
API_PORT=8000

# Local SQLite file for readings (7-day cache)
DB_PATH=dynaura.db

# Device key that signs every 1-minute summary (64 hex chars, with or without 0x).
# Leave empty to let the Pi create one in pi/.device_key on first run.
DEVICE_PRIVATE_KEY=

# 0G Compute Router (OpenAI-compatible). API key (sk-...) from pc.0g.ai. Check it with: cd pi && python zg_check.py
ZG_ROUTER_URL=https://router-api.0g.ai/v1
ZG_API_KEY=
# Check what's live: curl -H "Authorization: Bearer $ZG_API_KEY" $ZG_ROUTER_URL/models
ZG_MODEL=0gm-1.0-35b-a3b
# 0G vision model for the dust check (looks at the panel photo). 0G's own 0gm-1.0-35b-a3b takes
# text+image and is the one TEE-attested (TDX) vision model on the Router's /models list (Nov 2026).
# If it can't judge the frames (python zg_check.py shows), use qwen3-vl-plus instead.
# Empty, or the Router refuses the image: the dust check uses ZG_MODEL with the meter readings ("meter-only").
ZG_VISION_MODEL=0gm-1.0-35b-a3b
# Panel camera (pi/camera.py). A command that prints one JPEG, e.g. for the Pi camera:
#   CAMERA_CMD=rpicam-still -n -t 500 --width 640 --height 480 -o -
# or a fixed photo of the panel. Both empty: SIM uses pi/assets/camera/*.jpg, real hardware sends no photo.
CAMERA_CMD=
CAMERA_FILE=
# Longest wait for a 0G answer (seconds) and automatic retries. Measure with: cd pi && python planner.py
ZG_TIMEOUT_S=30
ZG_MAX_RETRIES=0

# 0G Storage: episode logs (Go CLI). The key is a 64-hex wallet key with testnet 0G, never the sk- API key.
ZG_STORAGE_CLI=0g-storage-client
ZG_RPC=https://evmrpc-testnet.0g.ai
ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
ZG_PRIVATE_KEY=
# EpisodeRegistry on 0G Galileo (address in zerog/deployments.json). Empty = episodes are not indexed on chain.
# The ZG_PRIVATE_KEY wallet must be the registry's device (zerog/README.md).
ZG_REGISTRY=

# Arc testnet: USDC escrow, shop trade, billing. Contracts deployed from Arc Studio (contracts/README.md)
ARC_RPC_URL=https://rpc.testnet.arc.io
# Pi wallet = the contracts' oracle (64 hex). Needs testnet USDC (also the gas): faucet.circle.com
ARC_PRIVATE_KEY=
ARC_ESCROW=
ARC_SHOP=
ARC_BILLING=
# SolarCredits (fair share of the spare sun). Empty = credits are computed but not settled on Arc.
ARC_CREDITS=0x12b06e364ecc08aead9ce2142382682b9d46859c
ARC_CREDITS_FROM_BLOCK=71074539

# Panel cleaning escrow. PANEL_BEST_W = what the clean panel gives with all flats on solar
# (measure it once under the demo lamp). SIM mode does not need it.
PANEL_BEST_W=
DUST_PCT=70
CLEAN_PCT=90
# Release also needs output this many points above the dusty level (Pawan's rule)
MIN_GAIN_PCT=15
CLEAN_FEE_USDC=2
CLEAN_DEADLINE_MIN=60
CLEAN_AUTO=true

# Monthly bills on Arc: 1 Wh on the model = 1 kWh in the real building
BILL_SCALE=1000
SOLAR_RATE_USDC=0.008
GRID_RATE_USDC=0.02
# The 0G trader (pi/trader.py). Its prices and TRADE_EVERY_MIN are in the credits block at the end.
# Least spare (model Wh) worth a 0G trade; a 1-minute sim window at noon is about 0.08 Wh.
TRADE_MIN_WH=0.01
# 0gm-1.0 thinks first: ~80 s per trade with thinking, ~6-11 s without. Trades only; the plan and dust check still think.
TRADE_THINKING=false
# Same for the daily plan: ~130 s with thinking (a second "Plan now" timed out at 150 s), seconds without.
PLAN_THINKING=false
# Optional: lock each bill to one wallet, e.g. A=0xabc...,B=0xdef...
FLAT_WALLETS=

# Arkiv (Rabdi testnet). The bridge (Node) owns the writes.
ARKIV_BRIDGE_URL=http://127.0.0.1:5100
# false = run without Arkiv (nothing is sent)
ARKIV_ENABLED=true
ARKIV_BRIDGE_PORT=5100
# Building wallet that owns every Arkiv record (64 hex). Fund with tGLM: hub.arkiv.network/faucet
ARKIV_PRIVATE_KEY=
# Free access key: hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
BUILDING_ID=sunrise-apartments

# ---- Fair share + solar credits (pi/credits.py, pi/trader.py) ----
# Off = nothing new runs. Each flat is paid for the sun it left unused: R * unused / sum(unused).
CREDITS_ENABLED=true
# Fair-share weights per flat (equal by default)
FLAT_SHARES=A:1,B:1,C:1
# USDC per real kWh. Feed-in rate for spare sun sold to the grid; the neighbour price defaults to
# the middle of EXPORT_RATE_USDC..GRID_RATE_USDC (0G may set another inside that band)
EXPORT_RATE_USDC=0.006
NEIGHBOR_RATE_USDC=
# How often 0G routes the spare (wall-clock minutes); POST /api/admin/credits/trade runs one now
TRADE_EVERY_MIN=15
# Standing shop demand per trade window, in MODEL Wh, on top of open ShopTrade orders. 0 = only real orders.
# Scale: the model's spare is about 0.6 Wh per 15-minute window at noon, so 15 would be ~25x too much.
# For the demo, SHOP_DEMAND_WH=0.2 lets 0G sell the shop about a third of each window's spare.
SHOP_DEMAND_WH=0
# Real board only: what the panel could give right now (W). The meter reads only what is drawn,
# so without this (or PANEL_BEST_W + a forecast) no spare is counted. Under the desk lamp: set it.
PANEL_AVAILABLE_W=
CREDITS_DB=credits.db
