# Default Pi address. Can be changed at runtime in the app (tap the Live/Demo pill), or with
# a link like https://<app>/?pi=https://<pi-tunnel>. An https page can't read an http Pi.
VITE_API_URL=http://localhost:8000
# The admin key is NOT set here: the committee admin types it in the app (Connection dialog),
# so it never ends up in the public bundle.
# Arkiv reads straight from the browser (Rabdi testnet), keyless on purpose: never put an Arkiv
# access key in a VITE_ variable, it ends up in the public bundle. Only the bridge has a key.
# The building wallet address that writes all records (from the bridge's /health)
VITE_ARKIV_OWNER=
VITE_BUILDING_ID=sunrise-apartments
# 0G (optional, public address): the Pi's 0G Storage wallet, for proof links not indexed yet
VITE_OG_WALLET=
# Arc testnet contracts (deployed from Arc Studio, see contracts/README.md)
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_ESCROW=
VITE_ARC_SHOP=
VITE_ARC_BILLING=
