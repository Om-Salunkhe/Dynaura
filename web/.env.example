# Where the Pi API runs. On the same Wi-Fi: http://dynaura.local:8000
VITE_API_URL=http://localhost:8000
# Same value as ADMIN_KEY in the root .env (lets the admin screens change jobs)
VITE_ADMIN_KEY=change-me
# Arkiv reads straight from the browser (Rabdi testnet)
VITE_ARKIV_ACCESS_KEY=
# The building wallet address that writes all records (from the bridge's /health)
VITE_ARKIV_OWNER=
VITE_BUILDING_ID=sunrise-apartments
# Arc testnet contracts (deployed from Arc Studio, see contracts/README.md)
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_ESCROW=
VITE_ARC_SHOP=
VITE_ARC_BILLING=
